//@version=6
indicator("Score Fase de Entrada v2 - Trend Following", overlay = true, max_labels_count = 50)

// ============================================================
// AJUSTE #1 - Normalización de lookbacks a días naturales
// (independiente del timeframe: diario, semanal, etc.)
// ============================================================
f_barsForDays(days) =>
    secPerBar  = timeframe.in_seconds()
    daysPerBar = secPerBar / 86400.0
    int(math.max(1, math.round(days / daysPerBar)))

// ============================================================
// INPUTS
// ============================================================
grpCapa1 = "Capa 1 - Universo operable"
maRapidaLen = input.int(50,  "MA rápida (periodos)", group = grpCapa1)
maLentaLen  = input.int(200, "MA lenta (periodos)",  group = grpCapa1)

grpCapa2 = "Capa 2 - Score (lookbacks en días naturales)"
rangeDias             = input.int(42,  "Días para el rango de consolidación (~6 semanas)", group = grpCapa2)
percentilDias         = input.int(365, "Días de histórico para percentil de amplitud", group = grpCapa2)
amplitudPercentilMax  = input.float(40.0, "Percentil máx. de amplitud (más bajo = más estrecho relativo a su propio histórico)", group = grpCapa2)
atrLen                = input.int(14, "Longitud ATR (periodos)", group = grpCapa2)
atrLookbackDias       = input.int(14, "Días atrás para comparar contracción de ATR", group = grpCapa2)
posRangoUmbral        = input.float(0.66, "Umbral posición dentro del rango (0-1)", group = grpCapa2)
volLenCorto           = input.int(5,  "Media de volumen reciente (periodos)", group = grpCapa2)
volLenLargo           = input.int(20, "Media de volumen base (periodos)", group = grpCapa2)
volKeepFactor         = input.float(0.8, "Factor mínimo de volumen sostenido (0-1, relajado)", group = grpCapa2)
triggerDias           = input.int(365, "Días para el máximo de referencia (~52 semanas)", group = grpCapa2)
distanciaMaxPct       = input.float(3.0, "Distancia máxima al disparador (%)", group = grpCapa2)

grpCanal = "Ajuste #3 - Detección de canal de tendencia"
canalDias        = input.int(60, "Días para la regresión del canal", group = grpCanal)
canalR2Min       = input.float(0.7, "R² mínimo para considerar canal válido", group = grpCanal)
canalDesviaciones = input.float(2.0, "Desviaciones típicas del canal", group = grpCanal)

grpMomentum = "Ajuste #5 - Confirmación de momentum (RSI, informativo, fuera del score)"
rsiLen                = input.int(14, "Longitud RSI", group = grpMomentum)
momentumDias          = input.int(60, "Días para comparar máximos de RSI vs precio", group = grpMomentum)
margenDivergenciaRSI  = input.float(5.0, "Margen de divergencia RSI (puntos)", group = grpMomentum)
margenPrecioCercaMax  = input.float(1.0, "Margen % para considerar precio 'cerca del máximo'", group = grpMomentum)

// ============================================================
// CONVERSIÓN DE DÍAS A BARRAS SEGÚN EL TIMEFRAME ACTUAL
// ============================================================
rangeLookback     = f_barsForDays(rangeDias)
percentilLookback = f_barsForDays(percentilDias)
atrLookbackBars   = f_barsForDays(atrLookbackDias)
triggerLookback   = f_barsForDays(triggerDias)
canalLookback     = f_barsForDays(canalDias)
momentumLookback  = f_barsForDays(momentumDias)

// ============================================================
// CAPA 1 - FILTRO DE UNIVERSO OPERABLE
// ============================================================
ma50  = ta.sma(close, maRapidaLen)
ma200 = ta.sma(close, maLentaLen)
capa1Ok = close > ma200 and ma50 > ma200

// ============================================================
// CAPA 2 - SCORE DE FASE DE ENTRADA (0-5)
// ============================================================

// --- Rango de consolidación ---
rangeHigh = ta.highest(high, rangeLookback)
rangeLow  = ta.lowest(low, rangeLookback)
amplitudPct = (rangeHigh - rangeLow) / rangeLow * 100.0

// 1) AJUSTE #2 - Amplitud relativa (percentil sobre su propio histórico), no un % fijo universal
amplitudPercentRank = ta.percentrank(amplitudPct, percentilLookback)
cond1 = amplitudPercentRank <= amplitudPercentilMax

// 2) Contracción de volatilidad (sin cambios de lógica, lookback ya normalizado)
atrActual = ta.atr(atrLen)
atrPasado = atrActual[atrLookbackBars]
cond2 = atrActual < atrPasado

// 3) Posición dentro del rango
posEnRango = (rangeHigh - rangeLow) != 0 ? (close - rangeLow) / (rangeHigh - rangeLow) : 0.0
cond3 = posEnRango > posRangoUmbral

// 4) AJUSTE #4 - Volumen relajado: no exige contracción+repunte exactos, solo que no se haya hundido
volMediaCorta = ta.sma(volume, volLenCorto)
volMediaLarga = ta.sma(volume, volLenLargo)
cond4 = volMediaCorta >= volMediaLarga * volKeepFactor

// 5) Distancia al disparador
maxReferencia = ta.highest(high, triggerLookback)
distanciaPct = (maxReferencia - close) / close * 100.0
cond5 = distanciaPct >= 0.0 and distanciaPct < distanciaMaxPct

score = (cond1 ? 1 : 0) + (cond2 ? 1 : 0) + (cond3 ? 1 : 0) + (cond4 ? 1 : 0) + (cond5 ? 1 : 0)
scoreFinal = capa1Ok ? score : 0

// ============================================================
// AJUSTE #3 - CLASIFICACIÓN DE SETUP: BASE vs CANAL DE TENDENCIA
// ============================================================
slopeCanal = ta.linreg(close, canalLookback, 0) - ta.linreg(close, canalLookback, 1)
rCanal = ta.correlation(bar_index, close, canalLookback)
r2Canal = rCanal * rCanal
canalValido = r2Canal >= canalR2Min and slopeCanal > 0

midCanal = ta.linreg(close, canalLookback, 0)
stdevCanal = ta.stdev(close, canalLookback)
canalSup = midCanal + canalDesviaciones * stdevCanal
canalInf = midCanal - canalDesviaciones * stdevCanal

setupTipo = canalValido ? "Canal de tendencia" : (cond1 ? "Base de compresión" : "Sin estructura clara")

// ============================================================
// AJUSTE #5 - ETIQUETA DE MOMENTUM (RSI), INFORMATIVA, FUERA DEL SCORE
// ============================================================
rsiVal = ta.rsi(close, rsiLen)
precioMaxMomentum = ta.highest(high, momentumLookback)
rsiMaxMomentum = ta.highest(rsiVal, momentumLookback)
precioCercaMax = close >= precioMaxMomentum * (1 - margenPrecioCercaMax / 100.0)
rsiCercaMax = rsiVal >= (rsiMaxMomentum - margenDivergenciaRSI)
momentumEtiqueta = not precioCercaMax ? "N/A" : (rsiCercaMax ? "Confirmado" : "Divergente")

// ============================================================
// VISUALIZACIÓN
// ============================================================
colorFondo = not capa1Ok ? na :
             scoreFinal >= 4 ? color.new(color.green, 85) :
             scoreFinal >= 2 ? color.new(color.yellow, 88) :
             color.new(color.red, 92)

bgcolor(colorFondo)

plot(rangeHigh, "Máximo del rango", color = color.new(color.blue, 40), style = plot.style_line)
plot(rangeLow,  "Mínimo del rango", color = color.new(color.blue, 40), style = plot.style_line)

canalSupPlot = canalValido ? canalSup : na
canalInfPlot = canalValido ? canalInf : na
plot(canalSupPlot, "Canal superior", color = color.new(color.orange, 30), style = plot.style_line)
plot(canalInfPlot, "Canal inferior", color = color.new(color.orange, 30), style = plot.style_line)

var table panel = table.new(position.top_right, 2, 9, border_width = 1)

if barstate.islast
    table.cell(panel, 0, 0, "Capa 1 (universo)", text_color = color.white, bgcolor = color.gray)
    table.cell(panel, 1, 0, capa1Ok ? "OK" : "NO", text_color = color.white, bgcolor = capa1Ok ? color.green : color.red)

    table.cell(panel, 0, 1, "1. Amplitud (percentil)", text_color = color.black)
    table.cell(panel, 1, 1, cond1 ? "✓" : "✗", text_color = color.black)

    table.cell(panel, 0, 2, "2. Contracción ATR", text_color = color.black)
    table.cell(panel, 1, 2, cond2 ? "✓" : "✗", text_color = color.black)

    table.cell(panel, 0, 3, "3. Posición rango", text_color = color.black)
    table.cell(panel, 1, 3, cond3 ? "✓" : "✗", text_color = color.black)

    table.cell(panel, 0, 4, "4. Volumen sostenido", text_color = color.black)
    table.cell(panel, 1, 4, cond4 ? "✓" : "✗", text_color = color.black)

    table.cell(panel, 0, 5, "5. Distancia gatillo", text_color = color.black)
    table.cell(panel, 1, 5, cond5 ? "✓" : "✗", text_color = color.black)

    table.cell(panel, 0, 6, "SCORE", text_color = color.white, bgcolor = color.navy)
    table.cell(panel, 1, 6, str.tostring(scoreFinal) + " / 5", text_color = color.white, bgcolor = color.navy)

    table.cell(panel, 0, 7, "Setup", text_color = color.black)
    table.cell(panel, 1, 7, setupTipo, text_color = color.black)

    table.cell(panel, 0, 8, "Momentum (RSI)", text_color = color.black)
    table.cell(panel, 1, 8, momentumEtiqueta, text_color = color.black)
